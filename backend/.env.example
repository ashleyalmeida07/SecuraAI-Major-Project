# --- AuthTrack Environment Variables ---

# Project Settings
PROJECT_NAME="AuthTrack"
API_V1_STR="/api/v1"

# ── LLM Provider ────────────────────────────────────────────────────────────
# Choices: "nvidia" | "openrouter" | "openai" | "anthropic"
LLM_PROVIDER="nvidia"

# NVIDIA NIM — get your free API key at https://build.nvidia.com
# Recommended free model: meta/llama-3.3-70b-instruct
LLM_MODEL="meta/llama-3.3-70b-instruct"
NVIDIA_API_KEY="your-nvidia-api-key-here"

# OpenRouter (alternative free models) — https://openrouter.ai/keys
# Example free model: "meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# OpenAI / Anthropic (kept for reference, not used when LLM_PROVIDER=nvidia)
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ── Database Configuration ───────────────────────────────────────────────────
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="authtrack"
POSTGRES_PORT="5432"

# ── ChromaDB Vector Store Configuration ─────────────────────────────────────
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000
